<div class="max-w-md mx-auto px-4 py-12">
  <div class="bg-brand-surface border border-brand-border rounded-2xl shadow-sm p-6 sm:p-8">
    <h1 class="font-display text-xl font-bold text-brand-text mb-6 text-center"><%= t("shared.items.register") %></h1>

    <% if @user.errors.any? %>
      <div class="bg-red-400 text-white rounded-xl p-3 mb-4 text-sm">
        <ul class="list-disc pl-4 space-y-1">
          <% @user.errors.full_messages.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with(model: @user) do |form| %>
      <div class="mb-4">
        <%= form.label :email, class: "block text-sm font-medium text-brand-text-secondary mb-1" %>
        <%= form.email_field :email, required: true,
            class: "w-full rounded-xl border border-brand-border bg-brand-surface px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold" %>
      </div>

      <div class="mb-4">
        <%= form.label :username, class: "block text-sm font-medium text-brand-text-secondary mb-1" %>
        <%= form.text_field :username, required: true,
            class: "w-full rounded-xl border border-brand-border bg-brand-surface px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold" %>
      </div>

      <div class="mb-4">
        <%= form.label :password, class: "block text-sm font-medium text-brand-text-secondary mb-1" %>
        <%= form.password_field :password, required: true,
            class: "w-full rounded-xl border border-brand-border bg-brand-surface px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold" %>
      </div>

      <div class="mb-6">
        <%= form.label :phone, class: "block text-sm font-medium text-brand-text-secondary mb-1" %>
        <%= form.telephone_field :phone, required: true,
            class: "w-full rounded-xl border border-brand-border bg-brand-surface px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold" %>
      </div>

      <%= form.submit t(".submit"),
          class: "w-full rounded-full bg-brand-gold px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-gold-hover transition-colors cursor-pointer" %>
    <% end %>

    <p class="text-sm text-brand-text-secondary text-center mt-6">
      <%= t(".has_account") %>
      <%= link_to t("shared.items.login"), new_session_path, class: "text-brand-gold hover:text-brand-gold-hover font-semibold" %>
    </p>
  </div>
</div>
