<%= link_to product_path(product),
    data: { carousel_target: "slide" },
    class: "hidden data-[position=0]:flex data-[position=1]:flex lg:data-[position=2]:flex lg:data-[position=3]:flex flex-col w-[calc(50%-0.375rem)] lg:w-[calc(25%-0.5625rem)] bg-white/5 rounded-xl overflow-hidden hover:bg-white/10 hover:scale-[1.02] hover:shadow-lg transition-all duration-200" do %>
  <%= image_tag product.cover_photo || "imagen por defecto.webp", class: "w-full h-32 sm:h-36 object-cover" %>
  <div class="p-3">
    <span class="block font-display font-bold text-brand-gold"><%= product.price %>$</span>
    <h3 class="font-display text-sm font-semibold text-white mt-0.5 truncate"><%= product.title %></h3>
  </div>
<% end %>
