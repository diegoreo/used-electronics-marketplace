<% content_for :title, @product.title %>
<% content_for :head do %>
  <meta property="og:type" content="product">
  <meta property="og:title" content="<%= @product.title %>">
  <meta property="og:description" content="<%= truncate(@product.description, length: 150) %>">
  <meta property="og:image" content="<%= product_og_image_url(@product) %>">
  <meta property="og:url" content="<%= product_url(@product) %>">
<% end %>

<%= render partial: "products/product_details", locals: { product: @product } %>
<%= link_to t(".edit"), edit_product_path(@product) if Current.user&.admin? %>
<%= link_to t(".delete"), product_path(@product), data:{
    turbo_method: :delete,
    turbo_confirm: t("common.confirm")
    } if Current.user&.admin? %>

<%= link_to t(".view_more_products", username: @product.user.username), 
  user_path(@product.user.username) %>

<%= render partial: "favorite", locals: { product: @product } %>
<%= link_to t(".request_product"), product_requests_path(product_id: @product.id), data: { turbo_method: :post } if Current.user %>
<%= turbo_stream_from @product %>
