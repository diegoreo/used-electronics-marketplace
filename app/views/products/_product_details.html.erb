<div id="<%= dom_id(product) %>" class="max-w-5xl mx-auto px-4 py-6 lg:flex lg:gap-10">
  <div class="lg:w-1/2">
    <% if product.photos.attached? %>
      <div data-controller="gallery">
        <div class="relative rounded-2xl overflow-hidden bg-brand-surface border border-brand-border">
          <% product.photos.each_with_index do |photo, index| %>
            <%= image_tag photo, data: { gallery_target: "slide" },
                class: "w-full h-72 sm:h-96 lg:h-full object-cover #{"hidden" unless index.zero?}" %>
          <% end %>

          <% if product.photos.count > 1 %>
            <button type="button" data-action="gallery#previous" aria-label="Anterior"
              class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-white/80 p-2 text-brand-text hover:bg-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
              </svg>
            </button>
            <button type="button" data-action="gallery#next" aria-label="Siguiente"
              class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-white/80 p-2 text-brand-text hover:bg-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          <% end %>
        </div>

        <% if product.photos.count > 1 %>
          <div class="flex gap-2 mt-3 overflow-x-auto">
            <% product.photos.each_with_index do |photo, index| %>
              <button type="button" data-action="gallery#show" data-gallery-index-param="<%= index %>" data-gallery-target="thumbnail"
                class="flex-none w-16 h-16 rounded-lg overflow-hidden border-2 #{index.zero? ? "border-brand-gold" : "border-transparent"}">
                <%= image_tag photo.variant(resize_to_fill: [100, 100]), class: "w-full h-full object-cover" %>
              </button>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="lg:w-1/2 mt-6 lg:mt-0">
    <h1 class="title font-display text-3xl font-extrabold text-brand-text"><%= product.title %></h1>
    <span class="price block mt-2 text-2xl font-bold text-brand-gold"><%= product.price %>$</span>
    <p class="description mt-4 text-brand-text-secondary leading-relaxed"><%= product.description %></p>

    <button type="button" data-controller="share"
      data-share-url-value="<%= product_url(product) %>"
      data-share-title-value="<%= product.title %>"
      data-share-copied-label-value="<%= t("products.show.copied") %>"
      data-action="click->share#share"
      class="mt-6 inline-flex items-center gap-2 rounded-full border border-brand-border px-5 py-2.5 text-sm font-semibold text-brand-text hover:border-brand-navy transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0-12.814a2.25 2.25 0 1 0 0-2.186 2.25 2.25 0 0 0 0 2.186zm0 12.814a2.25 2.25 0 1 0 0 2.186 2.25 2.25 0 0 0 0-2.186Z" />
      </svg>
      <span data-share-target="label"><%= t("products.show.share") %></span>
    </button>
  </div>
</div>
