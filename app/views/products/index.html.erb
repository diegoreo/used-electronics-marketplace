<%= turbo_frame_tag "home" do %>

  <% if @featured_products.any? %>
    <section id="featured-products" class="bg-brand-navy" data-controller="carousel">
      <div class="max-w-6xl mx-auto px-4 py-8 sm:py-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display text-xl sm:text-2xl font-extrabold text-white"><%= t(".featured_title") %></h2>
          <% if @featured_products.size > 2 %>
            <div class="flex items-center gap-2">
              <span class="text-xs text-white/60 font-semibold" data-carousel-target="counter"></span>
              <button type="button" data-action="carousel#previous" aria-label="Anterior"
                class="rounded-full border border-white/20 p-2 text-white hover:border-brand-gold hover:text-brand-gold transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                </svg>
              </button>
              <button type="button" data-action="carousel#next" aria-label="Siguiente"
                class="rounded-full border border-white/20 p-2 text-white hover:border-brand-gold hover:text-brand-gold transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </button>
            </div>
          <% end %>
        </div>

        <div class="flex flex-wrap gap-3">
          <%= render partial: "featured_product", collection: @featured_products, as: :product %>
        </div>
      </div>
    </section>
  <% end %>

  <div class="px-4 pt-4 lg:px-0">
    <%= form_with url: products_path, method: :get do |form| %>
      <div class="flex flex-col sm:flex-row gap-2 mt-2">
        <%= form.number_field :min_price, placeholder: t(".min_price"), onChange: "this.form.requestSubmit()", value: params[:min_price],
          class: "sm:w-1/3 rounded-xl border border-brand-border bg-brand-surface px-4 py-2 text-sm text-brand-text placeholder:text-brand-text-muted focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold" %>
        <%= form.number_field :max_price, placeholder: t(".max_price"), onChange: "this.form.requestSubmit()", value: params[:max_price],
          class: "sm:w-1/3 rounded-xl border border-brand-border bg-brand-surface px-4 py-2 text-sm text-brand-text placeholder:text-brand-text-muted focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold" %>
        <%= form.select :order_by, options_for_select(Product::ORDER_BY.keys.map {|order| [ t(".#{order}"), order] },
         params[:order_by]), {}, {onChange: "this.form.requestSubmit()",
          class: "sm:w-1/3 rounded-xl border border-brand-border bg-brand-surface px-4 py-2 text-sm text-brand-text-secondary focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold" } %>
      </div>
    <% end %>

    <div class="flex overflow-x-auto gap-2 py-4">
      <%= render(CategoryComponent.new) %>
      <%= render(CategoryComponent.with_collection(@categories)) %>
    </div>

    <p class="text-sm text-brand-text-secondary mb-2"><%= @products.count %> productos en existencia</p>
  </div>

  <%= turbo_frame_tag :products, class: "flex flex-col px-4 lg:px-0" do %>
    <%= turbo_frame_tag "products-#{@pagy.page}", class: "products flex flex-col w-full sm:flex-row sm:flex-wrap sm:gap-x-2" do %>
      <%= render partial: "product", collection: @products %>
      <%= turbo_frame_tag "products-#{@pagy.next}", class: "products flex flex-col w-full sm:flex-row sm:flex-wrap sm:gap-x-2", src: pagy_url_for(@pagy, @pagy.next),
        loading: :lazy if @pagy.next %>
    <% end %>
  <% end %>
<% end %>
