<% attended = product_request.attended? %>
<div id="<%= dom_id product_request %>" class="bg-brand-surface border border-brand-border rounded-2xl shadow-sm p-4 flex flex-col sm:flex-row sm:items-center gap-3">
  <div class="flex items-center gap-3 flex-1 min-w-0">
    <%= image_tag product_request.product.cover_photo || "imagen por defecto.webp", class: "w-14 h-14 rounded-lg object-cover flex-none" %>
    <div class="min-w-0">
      <%= link_to product_request.product.title, product_path(product_request.product), class: "font-semibold text-brand-text hover:text-brand-gold transition-colors block truncate" %>
      <p class="text-sm text-brand-text-secondary break-words">
        <%= product_request.user.username %> ·
        <%= link_to product_request.user.email, "mailto:#{product_request.user.email}", class: "hover:underline" %> ·
        <%= link_to product_request.user.phone, "tel:#{product_request.user.phone.gsub(/[\s-]/, "")}", class: "hover:underline" %>
      </p>
      <p class="text-xs text-brand-text-muted"><%= l(product_request.created_at) %></p>
    </div>
  </div>

  <div class="flex items-center gap-3 flex-none">
    <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold <%= attended ? "bg-green-50 text-green-700" : "bg-red-50 text-red-700" %>">
      <% if attended %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
          <path fill-rule="evenodd" d="M2.25 12a9.75 9.75 0 1 1 19.5 0 9.75 9.75 0 0 1-19.5 0Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" />
        </svg>
      <% else %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 6a.75.75 0 0 0-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 0 0 0-1.5h-3.75V6Z" clip-rule="evenodd" />
        </svg>
      <% end %>
      <%= attended ? t("product_requests.product_request.attended") : t("product_requests.product_request.not_attended") %>
    </span>

    <% if attended %>
      <%= link_to unattend_product_request_path(product_request, filter: filter), data: { turbo_method: :patch },
          class: "inline-flex items-center gap-1.5 rounded-full border border-brand-border px-3 py-1.5 text-xs font-semibold text-brand-text-secondary hover:border-brand-navy transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
        </svg>
        <%= t("product_requests.product_request.mark_unattended") %>
      <% end %>
    <% else %>
      <%= link_to attend_product_request_path(product_request, filter: filter), data: { turbo_method: :patch },
          class: "inline-flex items-center gap-1.5 rounded-full bg-brand-gold px-3 py-1.5 text-xs font-semibold text-white hover:bg-brand-gold-hover transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        <%= t("product_requests.product_request.mark_attended") %>
      <% end %>
    <% end %>
  </div>
</div>
